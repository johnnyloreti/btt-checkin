# Copy to .dev.vars for local `wrangler dev`. Never commit .dev.vars.
# In production these are Worker secrets set with `wrangler secret put <NAME>`.
GHL_TOKEN=
STAFF_PIN=
ID_SALT=
# Optional. Shared with the Netlify proxy on checkin.bttbridgewater.com so the
# Worker can read the real visitor address for rate limiting.
PROXY_KEY=
